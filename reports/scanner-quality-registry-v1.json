  "version": "scanner-quality-registry-v1",
  "date": "2026-09-08",
  "purpose": "Completed scanner research promotion registry for future taramabot integration. Historical results are observed data; true independent confirmation is future unseen bars.",
  "admission_gate": {
    "production_candidate": {
      "positive_chronological_folds": "4/4",
      "worst_fold_expectancy_r_gt": 0.0,
      "profit_factor_gte": 1.25,
      "expectancy_r_gte": 0.10,
      "completed_trades_gte": 300,
      "monthly_timeframe_allowed": false,
      "locked_final_status_required": true
    },
    "secondary": "Final result is 4/4 but the locked research explicitly says the edge materially depends on custom/adaptive risk management or the entry alone was not robust.",
    "forward_watch": "All 1M models and/or small/uneven samples. Never route as normal production alerts until new forward evidence grows.",
    "research": "Potentially interesting but <=3/4 positive folds, negative worst fold, or explicitly non-production in the final report.",
    "reject": "Negative expectancy, PF <= 1, <=2/4 robustness, mathematical design issue, or explicit final rejection."
  },
  "quality_score_v1": {
    "purpose": "Ranking aid only; admission gate and explicit management-dependence override the numeric score.",
    "max": 100,
    "weights": {
      "fold_robustness": 25,
      "worst_fold_expectancy": 20,
      "expectancy": 20,
      "profit_factor": 15,
      "sample_size": 15,
      "entry_independence": 5
    },
    "formula": {
      "fold_robustness": "4/4=25; 3/4=15; 2/4=5; otherwise=0",
      "worst_fold_expectancy": "20 * clamp(worst_fold_R, 0, 0.40) / 0.40",
      "expectancy": "20 * clamp(expectancy_R, 0, 0.80) / 0.80",
      "profit_factor": "15 * clamp(PF - 1, 0, 2) / 2",
      "sample_size": "15 * min(log10(completed_trades) / 4, 1)",
      "entry_independence": "ACTIVE=5; ACTIVE_SECONDARY=2; RESEARCH/WATCH=0"
    },
    "promotion_bands_after_gate": {
      "CORE": "score >= 75 and not explicitly management-dependent",
      "ACTIVE": "score < 75 and production gate passed",
      "SECONDARY": "explicit management-dependence; score cannot upgrade it to CORE/ACTIVE"
    }
  },
  "global_policy": {
    "CORE": "Primary production scanner. Highest alert/report weight.",
    "ACTIVE": "Normal production scanner.",
    "SECONDARY": "Production early-warning / supporting signal. Lower confidence weight; never presented as equivalent to CORE.",
    "FORWARD_WATCH": "Calculate and store forward performance, but do not route as ordinary production signal.",
    "RESEARCH": "Keep in deneme; optional research/early-warning channel only.",
    "REJECT": "Do not integrate as production scanner.",
    "monthly_harmonization": "All 1M models are FORWARD_WATCH in the common registry even when an older individual report used a stronger label.",
    "overlap_warning": "Do not sum scanner quality scores directly. Many scanners share MACD/RSI/BB/volume inputs; future stock-confidence scoring must apply signal-overlap/correlation penalties."
  },
